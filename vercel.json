{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "islamicschoolreview.com"
        }
      ],
      "destination": "https://www.islamicschoolreview.com/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sign-in",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/sign-up",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/schools/:slug.html",
      "destination": "/schools/:slug",
      "permanent": true
    },
    {
      "source": "/states/:state.html",
      "destination": "/states/:state",
      "permanent": true
    },
    {
      "source": "/cities/:state/:city.html",
      "destination": "/cities/:state/:city",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/schools/:slug",
      "destination": "/api/school-page?slug=:slug"
    },
    {
      "source": "/states/:state",
      "destination": "/api/seo-page?kind=state&state=:state"
    },
    {
      "source": "/cities/:state/:city",
      "destination": "/api/seo-page?kind=city&state=:state&city=:city"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-page?kind=sitemap"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
